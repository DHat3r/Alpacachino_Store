# ─────────────────────────────────────────────────────────────
#  AlpacachinoStore — plantilla de variables de entorno
#  Copiar a .env y completar los secretos:
#    Copy-Item .env.example .env      (Windows)
#    cp .env.example .env             (Linux / macOS)
# ─────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────
APP_NAME=AlpacachinoStore
ENV=development
DEBUG=true
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
API_PORT=8000

# ── Base de datos ────────────────────────────────────────────
# Si DATABASE_URL está definida (Supabase/Render) tiene prioridad sobre
# las variables POSTGRES_* individuales.
# Supabase:
#   - Conexión directa:  postgresql://postgres:<clave>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   - Pooler (recomendado): postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#     (el puerto 6543 desactiva las sentencias preparadas automáticamente)
DATABASE_URL=
POSTGRES_USER=alpaca
POSTGRES_PASSWORD=alpaca_dev_pass
POSTGRES_DB=alpacachino
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Latido contra la base: consulta el inventario cada N segundos para que
# Supabase no cierre la sesión ociosa. 0 lo desactiva.
DB_KEEPALIVE_SECONDS=5

# ── Supabase ─────────────────────────────────────────────────
# Solo las usa el backend: el frontend nunca se conecta a Supabase de forma
# directa, todo pasa por /api.
# La BASE DE DATOS se conecta con DATABASE_URL, no con estas claves.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Pagos (sandbox) ──────────────────────────────────────────
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=
WEBPAY_ENV=integration

# ── Bots Meta ────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── Correo ───────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ventas@alpacachino.com

# ── Reglas de negocio ────────────────────────────────────────
STOCK_RESERVATION_MINUTES=15
