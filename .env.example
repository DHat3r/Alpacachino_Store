# ─────────────────────────────────────────────────────────────
#  AlpacachinoStore — plantilla de variables de entorno
#  Copiar a .env y completar los secretos:
#    Copy-Item .env.example .env      (Windows)
#    cp .env.example .env             (Linux / macOS)
# ─────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────
APP_NAME=AlpacachinoStore
ENV=development
DEBUG=true
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
API_PORT=8000

# ── Base de datos ────────────────────────────────────────────
# Si DATABASE_URL está definida (Supabase/Render) tiene prioridad sobre
# las variables POSTGRES_* individuales.
# Supabase:
#   - Pooler (USAR ESTE): postgresql://postgres.<ref>:<clave>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#     Puerto 5432 = modo sesión (recomendado para SQLAlchemy/Alembic);
#     el 6543 (transacción) desactiva las sentencias preparadas.
#   - Conexión directa: postgresql://postgres:<clave>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#     OJO: ese host resuelve solo IPv6 y NO funciona desde Docker
#     ("Network is unreachable"). El pooler sí tiene IPv4.
DATABASE_URL=
POSTGRES_USER=alpaca
POSTGRES_PASSWORD=alpaca_dev_pass
POSTGRES_DB=alpacachino
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Latido contra la base: consulta el inventario cada N segundos para que
# Supabase no cierre la sesión ociosa. 0 lo desactiva.
DB_KEEPALIVE_SECONDS=300

# ── Supabase ─────────────────────────────────────────────────
# Solo las usa el backend: el frontend nunca se conecta a Supabase de forma
# directa, todo pasa por /api.
# La BASE DE DATOS se conecta con DATABASE_URL, no con estas claves.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Pagos (sandbox) ──────────────────────────────────────────
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=
WEBPAY_ENV=integration

# ── Bots Meta ────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── Correo ───────────────────────────────────────────────────
# En local no hay contenedor mailhog: los correos quedan en el log del worker.
# En producción usa el SMTP del proveedor y STARTTLS=true.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=ventas@alpacachino.com

# ── Reglas de negocio ────────────────────────────────────────
STOCK_RESERVATION_MINUTES=15
# Reserva de stock cuando PAYMENT_PROVIDER=manual (transferencia), en horas.
MANUAL_PAYMENT_HOURS=24
SHIPPING_COST=3500
FREE_SHIPPING_FROM=30000
CURRENCY=CLP
TERMS_VERSION=2026-10
SELLER_NAME=AlpacachinoStore
SELLER_EMAIL=ventas@alpacachino.com
SELLER_PHONE=

# ── Pago manual por transferencia ────────────────────────────
# Con PAYMENT_PROVIDER=manual el checkout devuelve estos datos en lugar de
# una pasarela; el admin confirma el pago desde /admin → Pedidos.
BANK_NAME=
BANK_ACCOUNT_TYPE=Cuenta corriente
BANK_ACCOUNT_NUMBER=
BANK_HOLDER=
BANK_RUT=
BANK_EMAIL=

# ── Portadas (Supabase Storage) ──────────────────────────────
# La secret key del .env debe ser válida (hoy devuelve 401: regenerar en
# Supabase → Project Settings → API). El bucket debe existir y ser público
# para lectura.
MAX_COVER_MB=2
SUPABASE_STORAGE_BUCKET=product-covers

